# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
.env

# Testing / tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime-generated content (keep the folders, ignore their contents)
logs/*.log
output/*
!output/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
